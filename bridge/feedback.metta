; Feedback: AF-filtered proof → wage proof legs → one ECAN cycle → STI/AF metrics.
; Times the PLN.Query (wall_ms).
!(bind! &ans (new-state ()))
!(bind! &pln-ms (new-state 0.0))
!(let $pair (pln-query-timed (filter-kb (fx-tables) (fx-query-objects) (get-state &Fold))
                             (fx-query-term) (get-state &B))
     (let* (($a (car-atom $pair))
            ($ms (car-atom (cdr-atom $pair)))
            ($_ (change-state! &ans $a))
            ($_2 (change-state! &pln-ms $ms)))
          done))
!(bind! &proof (new-state ()))
!(change-state! &proof (proof-objects (get-state &ans)))
!(println! (feedback ans (get-state &ans) stamps (pln-stamps (get-state &ans))
   proof (get-state &proof) ms (get-state &pln-ms)))

!(bind! &F0 (new-state ()))
!(change-state! &F0 (positive-focus (getAfAtoms)))
!(bind! &sti0 (new-state ()))
!(change-state! &sti0 (sti-pairs (get-state &proof)))
!(bind! &pin0 (new-state ()))
!(change-state! &pin0 (in-focus (get-state &proof) (get-state &F0)))

!(wage! (get-state &proof) (get-state &wage))
; Let ECAN re-settle after proof wage (rent/diffusion/hebbian + WA)
!(ecan-cycle!)

!(bind! &F1 (new-state ()))
!(change-state! &F1 (positive-focus (getAfAtoms)))
!(bind! &sti1 (new-state ()))
!(change-state! &sti1 (sti-pairs (get-state &proof)))
!(bind! &pin1 (new-state ()))
!(change-state! &pin1 (in-focus (get-state &proof) (get-state &F1)))
!(bind! &newF (new-state ()))
!(change-state! &newF (new-in-focus (get-state &proof) (get-state &F0) (get-state &F1)))

!(println! (feedback F0 (get-state &F0) F1 (get-state &F1)
   new (get-state &newF) pin0 (get-state &pin0) pin1 (get-state &pin1)
   sti0 (get-state &sti0) sti1 (get-state &sti1)))

!(py-call (cognitive_synergy_io.write_summary (fx-out-feedback)
   ((scenario (fx-name)) (protocol "feedback") (budget (get-state &B))
    (query (fx-query-label)) (ecan_cycles (fx-cycles))
    (focus0 (get-state &F0)) (focus1 (get-state &F1))
    (pln ((solved (pln-solved (get-state &ans))) (confidence (pln-confidence (get-state &ans)))
          (stamps (pln-stamps (get-state &ans))) (wall_ms (get-state &pln-ms))
          (answer (get-state &ans))))
    (pln_wall_ms (get-state &pln-ms))
    (proof_objects (get-state &proof))
    (proof_in_focus0 (get-state &pin0))
    (proof_in_focus1 (get-state &pin1))
    (newly_focused (get-state &newF))
    (sti_before (get-state &sti0))
    (sti_after (get-state &sti1)))))
