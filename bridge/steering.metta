; Steering: three arms under fixed budget B.
;   weighted    — all premises (full table set)
;   influenced  — Cq∧AF with real focus F
;   distracted  — Cq∧AF with random S, |S|=|F|
; Times each PLN.Query (wall_ms).

!(bind! &weighted (new-state ()))
!(bind! &weighted-ms (new-state 0.0))
!(let $pair (pln-query-timed (fx-kb-full) (fx-query-term) (get-state &B))
     (let* (($ans (car-atom $pair))
            ($ms (car-atom (cdr-atom $pair)))
            ($_ (change-state! &weighted $ans))
            ($_2 (change-state! &weighted-ms $ms)))
          done))

!(bind! &influenced-n (new-state 0))
!(change-state! &influenced-n (n-kept (fx-tables) (fx-query-objects) (get-state &F)))
!(bind! &influenced (new-state ()))
!(bind! &influenced-ms (new-state 0.0))
!(let $pair (pln-query-timed (filter-kb (fx-tables) (fx-query-objects) (get-state &F))
                             (fx-query-term) (get-state &B))
     (let* (($ans (car-atom $pair))
            ($ms (car-atom (cdr-atom $pair)))
            ($_ (change-state! &influenced $ans))
            ($_2 (change-state! &influenced-ms $ms)))
          done))

!(bind! &distracted-S (new-state ()))
!(let* (($names (py-call (cognitive_synergy_io.sample_as_list (fx-pool) (get-state &k) (get-state &rngSeed)))))
    (change-state! &distracted-S (collapse (let $n (superpose $names) $n))))
!(bind! &distracted-n (new-state 0))
!(change-state! &distracted-n (n-kept (fx-tables) (fx-query-objects) (get-state &distracted-S)))
!(bind! &distracted (new-state ()))
!(bind! &distracted-ms (new-state 0.0))
!(let $pair (pln-query-timed (filter-kb (fx-tables) (fx-query-objects) (get-state &distracted-S))
                             (fx-query-term) (get-state &B))
     (let* (($ans (car-atom $pair))
            ($ms (car-atom (cdr-atom $pair)))
            ($_ (change-state! &distracted $ans))
            ($_2 (change-state! &distracted-ms $ms)))
          done))

!(bind! &ov (new-state 0.0))
!(change-state! &ov (query-af-overlap (fx-query-objects) (get-state &F)))

!(println! (steering (fx-name) F (get-state &F) ov (get-state &ov)
   weighted (pln-solved (get-state &weighted)) (pln-confidence (get-state &weighted)) ms (get-state &weighted-ms)
   influenced (pln-solved (get-state &influenced)) (pln-confidence (get-state &influenced)) n (get-state &influenced-n) ms (get-state &influenced-ms)
   distracted (pln-solved (get-state &distracted)) (pln-confidence (get-state &distracted)) n (get-state &distracted-n) ms (get-state &distracted-ms)
   distractedS (get-state &distracted-S) seed (get-state &rngSeed)))

!(py-call (cognitive_synergy_io.write_summary (fx-out)
   ((scenario (fx-name)) (protocol "steering") (budget (get-state &B)) (query (fx-query-label))
    (ecan_cycles (fx-cycles)) (random_seed (get-state &rngSeed))
    (focus_seed (get-state &Fseed)) (focus (get-state &F))
    (query_objects (fx-query-objects)) (query_af_overlap (get-state &ov))
    (distracted_S (get-state &distracted-S))
    (weighted ((solved (pln-solved (get-state &weighted))) (confidence (pln-confidence (get-state &weighted)))
               (n_premises (fx-n-tables)) (wall_ms (get-state &weighted-ms)) (answer (get-state &weighted))))
    (influenced ((solved (pln-solved (get-state &influenced))) (confidence (pln-confidence (get-state &influenced)))
                 (n_premises (get-state &influenced-n)) (wall_ms (get-state &influenced-ms)) (answer (get-state &influenced))))
    (distracted ((solved (pln-solved (get-state &distracted))) (confidence (pln-confidence (get-state &distracted)))
                 (n_premises (get-state &distracted-n)) (wall_ms (get-state &distracted-ms)) (answer (get-state &distracted)))))))
